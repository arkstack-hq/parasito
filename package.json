{
    "name": "parasito",
    "version": "0.1.9",
    "description": "Universal TypeScript-first HTTP testing library for Express, Fastify, H3, Hono, Node servers, and fetch-style apps.",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "license": "MIT",
    "homepage": "https://github.com/arkstack-tmp/parasito",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-tmp/parasito.git"
    },
    "keywords": [
        "testing",
        "modern",
        "web",
        "framework",
        "nodejs",
        "typescript",
        "supertest",
        "superagent",
        "laravel",
        "requests",
        "api",
        "builder",
        "test",
        "assertions",
        "mocks",
        "stubs",
        "http",
        "https",
        "pest"
    ],
    "scripts": {
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage --watch=false",
        "typecheck": "tsc --noEmit",
        "build": "pnpm barrel && tsdown",
        "barrel": "barrelize",
        "prepublishOnly": "pnpm build && pnpm vitest --watch=false",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "install:arkstack": "pnpm create arkstack test/arkstack-app -n arkstack-app -d arkstack-app -k express -li"
    },
    "dependencies": {
        "superagent": "^10.3.0"
    },
    "devDependencies": {
        "@arkstack/auth": "^0.9.1",
        "@arkstack/common": "^0.9.1",
        "@arkstack/contract": "^0.9.1",
        "@arkstack/database": "^0.9.1",
        "@arkstack/driver-express": "^0.9.1",
        "@arkstack/http": "^0.9.1",
        "@arkstack/notifications": "^0.9.1",
        "@arkstack/view": "^0.9.1",
        "@eslint/js": "latest",
        "@eslint/markdown": "^8.0.1",
        "@h3ravel/support": "^0.15.11",
        "@kanun-hq/plugin-file": "^0.1.12",
        "@types/express": "^5.0.6",
        "@types/koa": "^3.0.2",
        "@types/node": "^20.11.0",
        "@types/superagent": "^8.1.9",
        "@vitest/coverage-v8": "^4.1.7",
        "arkormx": "^2.4.1",
        "barrelize": "^1.7.4",
        "clear-router": "^2.7.7",
        "cors": "^2.8.6",
        "eslint": "^10.0.2",
        "express": "^5.2.1",
        "fastify": "^5.8.2",
        "h3": "2.0.1-rc.21",
        "hono": "^4.12.8",
        "kanun": "^1.2.0",
        "koa": "^3.2.0",
        "node": "^24.16.0",
        "resora": "^1.3.6",
        "tsdown": "^0.21.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "vitepress": "2.0.0-alpha.16",
        "vitest": "^4.1.7"
    }
}
