{
    "name": "parasito",
    "version": "0.1.4",
    "description": "Universal TypeScript-first HTTP testing library for Express, Fastify, H3, Hono, Node servers, and fetch-style apps.",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "homepage": "https://github.com/arkstack-hq/parasito",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arkstack-hq/parasito.git"
    },
    "keywords": [
        "testing",
        "modern",
        "web",
        "framework",
        "nodejs",
        "typescript",
        "supertest",
        "superagent",
        "laravel",
        "requests",
        "api",
        "builder",
        "test",
        "assertions",
        "mocks",
        "stubs",
        "http",
        "https",
        "pest"
    ],
    "scripts": {
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage --watch=false",
        "typecheck": "tsc --noEmit",
        "build": "pnpm barrel && tsdown",
        "barrel": "barrelize",
        "prepublishOnly": "pnpm build && pnpm vitest --watch=false",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "superagent": "^10.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/markdown": "^8.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^20.11.0",
        "@types/superagent": "^8.1.9",
        "@vitest/coverage-v8": "^4.1.5",
        "barrelize": "^1.7.4",
        "eslint": "^10.0.2",
        "express": "^5.2.1",
        "fastify": "^5.8.2",
        "h3": "2.0.1-rc.21",
        "hono": "^4.12.8",
        "tsdown": "^0.21.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitepress": "2.0.0-alpha.16",
        "vitest": "^4.1.5"
    }
}
