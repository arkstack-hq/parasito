{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023", "DOM"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "include": ["src", "test"]
}
